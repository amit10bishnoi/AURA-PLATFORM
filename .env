# AURA Platform — Environment Variables
# Copy this to .env and fill in your values

# Security
SECRET_KEY=your-super-secret-key-change-this-in-production

# Database (default: SQLite — change to PostgreSQL for production)
DATABASE_URL=sqlite:///./aura.db
# DATABASE_URL=postgresql://user:password@localhost:5432/aura

# AI Features
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Email Alerts
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASSWORD=your-gmail-app-password
ALERT_FROM_EMAIL=noreply@aura-platform.com

# Scheduler
SCHEDULER_ENABLED=true

# Identity Providers (optional — simulated if not set)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
GOOGLE_WORKSPACE_DOMAIN=
GOOGLE_SERVICE_ACCOUNT_JSON=

# Patch Management (optional)
INTUNE_TENANT_ID=
JAMF_URL=
JAMF_CLIENT_ID=
JAMF_CLIENT_SECRET=

# Asset Inventory (optional)
AZURE_SUBSCRIPTION_ID=
GCP_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
